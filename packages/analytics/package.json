{
  "name": "@eggbot/analytics",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic, provider-neutral fantasy-football analytics for EggBot",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencer-dye/eggbot.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://github.com/spencer-dye/eggbot#readme",
  "bugs": {
    "url": "https://github.com/spencer-dye/eggbot/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --composite false"
  },
  "dependencies": {
    "@eggbot/core": "workspace:*",
    "@eggbot/football-data": "workspace:*"
  }
}
